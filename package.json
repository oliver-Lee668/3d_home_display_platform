{
  "name": "furniture-showroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web 3D 家具家电仿真展示平台 (MVP)",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:sales": "vite --mode sales --port 5184 --strictPort",
    "dev:factory": "vite --mode factory --port 5175 --strictPort",
    "build": "tsc && vite build",
    "build:user": "tsc && vite build --mode user",
    "build:sales": "tsc && vite build --mode sales",
    "build:factory": "tsc && vite build --mode factory",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
